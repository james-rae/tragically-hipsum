{
    "name": "tragically-hipsum",
    "version": "1.0.0",
    "description": "A lorem ipsum generator that uses lyrics by The Tragically Hip",
    "author": "James Rae",
    "homepage": "https://github.com/james-rae/tragically-hipsum",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/james-rae/tragically-hipsum.git"
    },
    "keywords": [],
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
