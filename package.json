            "default": "./dist/index.mjs"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "vite build --watch",
        "start": "vite --host --open",
        "build": "vite build"
    },
    "peerDependencies": {},
    "devDependencies": {
        "@types/node": "^24.7.0",
        "prettier": "^3.2.4",
        "tslib": "^2.8.1",
        "typescript": "^5.9.3",
        "vite": "^7.1.9",
        "vite-plugin-dts": "^4.5.4"
    }
}
